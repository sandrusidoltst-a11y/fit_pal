    {
      "type": "text",
      "id": "n3_body",
      "x": 35,
      "y": 680,
      "width": 340,
      "height": 90,
      "text": "LLM-driven food match disambiguation\n· no_results — empty → NO_MATCH\n· single_result — 1 match → auto-SELECTED\n· empty_pending — auto-select first result\n· clear_match — LLM picks best from list\n· ambiguous — too similar → NO_MATCH",
      "originalText": "LLM-driven food match disambiguation\n· no_results — empty → NO_MATCH\n· single_result — 1 match → auto-SELECTED\n· empty_pending — auto-select first result\n· clear_match — LLM picks best from list\n· ambiguous — too similar → NO_MATCH",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
