    {
      "type": "text",
      "id": "n5_body",
      "x": 35,
      "y": 950,
      "width": 340,
      "height": 120,
      "text": "HITL batch confirmation via interrupt()\n· payload_structure — question, items, totals\n· estimated_tag — shows \"(estimated)\" label\n· totals — batch sums correctly\n· confirm → Command(goto=\"commit\")\n· reject → Command(goto=\"response\")\n· edit — re-interrupt then confirm\n· no_pending — skip to response",
      "originalText": "HITL batch confirmation via interrupt()\n· payload_structure — question, items, totals\n· estimated_tag — shows \"(estimated)\" label\n· totals — batch sums correctly\n· confirm → Command(goto=\"commit\")\n· reject → Command(goto=\"response\")\n· edit — re-interrupt then confirm\n· no_pending — skip to response",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
